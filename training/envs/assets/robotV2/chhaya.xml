  <option timestep="0.005" integrator="implicitfast" />
  <default>
    <!-- damping=0: passive joint damping removed; velocity damping is now in the Python PD -->
    <joint damping="0" armature="0.04" frictionloss="0.2" />
  </default>
  <actuator>
    <!-- motor (torque pass-through). The real limit is applied in Python:
         biped_env_v2._clip_effort_dcmotor gives the four-quadrant torque-speed envelope
         (flat +-0.98 N-m to 3.14 rad/s, drooping to 0 at 4.71), mirroring Isaac's DCMotorCfg.
         ctrlrange is the STALL torque (2.94 N-m) - the absolute physical ceiling, and a
         backstop that would catch a future bug where the Python clip is bypassed. -->
    <motor name="l_hip_yaw" joint="l_hip_yaw" ctrlrange="-2.94 2.94" />
    <motor name="r_hip_yaw" joint="r_hip_yaw" ctrlrange="-2.94 2.94" />
